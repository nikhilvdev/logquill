{
  "group": "trace-headers",
  "description": "Reading a trace id out of a W3C traceparent, an AWS X-Ray header or a GCP Cloud Trace header.",
  "references": {
    "python": "2.0.0",
    "js": "4354829"
  },
  "cases": [
