{
  "group": "alert-dedupe",
  "description": "Collapsing repeated errors into one alert with a count, over a deterministic clock.",
  "references": {
    "python": "2.0.0",
    "js": "4354829"
  },
  "js_gaps": [
    "alert deduplication is not exercised with a fake clock in the JavaScript package"
  ],
  "cases": [
    {
      "name": "the first error alerts at once, repeats are counted",
      "input": {
        "steps": [
          {
            "at": 0,
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "ERROR",
              "logger": "app",
              "message": "boom",
              "meta": {}
            }
          },
          {
            "at": 10,
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "ERROR",
              "logger": "app",
              "message": "boom",
              "meta": {}
            }
          },
          {
            "at": 20,
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "ERROR",
              "logger": "app",
              "message": "boom",
              "meta": {}
            }
          }
        ],
        "end": 100,
        "options": {
          "dedupe_window_seconds": 60
        }
      },
      "expected": {
        "steps": [
          {
            "sent": [
              {
                "message": "boom",
                "occurrences": 1
              }
            ]
          },
          {
            "sent": []
          },
          {
            "sent": []
          }
        ],
        "after": [
          {
            "message": "boom",
            "occurrences": 3
          }
        ],
        "tracked": 0
      }
    },
