{
  "group": "graph-rows",
  "description": "The node, parent edge and session a record becomes in a graph database, and the shared Cypher statement.",
  "references": {
    "python": "2.0.0",
    "js": "4354829"
  },
  "js_gaps": [
    "no graph transport in the JavaScript package"
  ],
  "cases": [
    {
      "name": "row: a span record",
      "input": {
        "op": "row",
        "record": {
          "schema_version": "2.0",
          "timestamp": "2026-01-01T00:00:00.123Z",
          "level": "INFO",
          "logger": "app.db",
          "message": "step",
          "meta": {
            "span_id": "s1",
            "run_id": "r1",
            "parent_span_id": "p1",
            "trace_id": "t1"
          }
        }
      },
      "expected": {
        "row": {
          "key": "s1",
          "props": {
            "timestamp": "2026-01-01T00:00:00.123Z",
            "level": "INFO",
            "logger": "app.db",
            "message": "step",
            "meta": "{\"span_id\":\"s1\",\"run_id\":\"r1\",\"parent_span_id\":\"p1\",\"trace_id\":\"t1\"}",
            "run_id": "r1",
            "trace_id": "t1",
            "span_id": "s1",
            "parent_span_id": "p1"
          },
          "session_key": "r1",
          "parent_key": "p1"
        }
      }
    },
