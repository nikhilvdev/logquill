    {
      "name": "the statement",
      "input": {
        "op": "statement"
      },
      "expected": {
        "cypher": "UNWIND $rows AS row MERGE (n:LogRecord {key: row.key}) SET n += row.props FOREACH (_ IN CASE WHEN row.session_key IS NULL THEN [] ELSE [1] END |   MERGE (s:Session {key: row.session_key})   MERGE (s)-[:HAS_RECORD]->(n) ) FOREACH (_ IN CASE WHEN row.parent_key IS NULL THEN [] ELSE [1] END |   MERGE (p:LogRecord {key: row.parent_key})   MERGE (p)-[:PARENT_OF]->(n) )"
      }
    }
  ]
}
