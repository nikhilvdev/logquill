          "session_key": null,
          "parent_key": null
        }
      },
      "differs": {
        "python": {
          "row": {
            "key": "s1",
            "props": {
              "timestamp": "2026-01-01T00:00:00.123Z",
              "level": "INFO",
              "logger": "app.db",
              "message": "\u65e5\u672c",
              "meta": "{\"span_id\":\"s1\",\"name\":\"caf\\u00e9\"}",
              "span_id": "s1"
            },
            "session_key": null,
            "parent_key": null
          }
        }
      },
      "rule": "09 \u2014 graph rows exist in Python only; every binding reaches them"
    },
