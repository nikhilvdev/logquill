{
  "group": "canonical-json",
  "description": "Canonical JSON text (Python json.dumps with sorted keys and ASCII escapes) and its SHA-256, for hostile values.",
  "references": {
    "python": "2.0.0",
    "js": "4354829"
  },
  "cases": [
    {
      "name": "empty object",
      "input": {
        "json": "{}"
      },
      "expected": {
        "text": "{}",
        "sha256": "44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a"
      }
    },
    {
      "name": "empty array",
      "input": {
        "json": "[]"
      },
      "expected": {
        "text": "[]",
        "sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945"
      }
    },
    {
      "name": "empty string",
      "input": {
        "json": "\"\""
      },
      "expected": {
        "text": "\"\"",
        "sha256": "12ae32cb1ec02d01eda3581b127c1fee3b0dc53572ed6baf239721a03d82e126"
      }
    },
    {
      "name": "keys sort by code point",
      "input": {
        "json": "{\"b\":1,\"a\":2,\"B\":3,\"_\":4,\"\u00e9\":5,\"Z\":6}"
      },
      "expected": {
        "text": "{\"B\": 3, \"Z\": 6, \"_\": 4, \"a\": 2, \"b\": 1, \"\\u00e9\": 5}",
        "sha256": "79affd24324d44315ceacbda0213a4b14ef2c9342acd9f58fe116da262177f5b"
      }
    },
    {
      "name": "nested keys sort at every depth",
      "input": {
        "json": "{\"z\":{\"y\":1,\"x\":[{\"d\":1,\"c\":2}]},\"a\":{}}"
      },
      "expected": {
        "text": "{\"a\": {}, \"z\": {\"x\": [{\"c\": 2, \"d\": 1}], \"y\": 1}}",
        "sha256": "b9b7f1ced71cca8e514486b13ee71e6dbf00346f139801aadcc02bf29d527bd2"
      }
    },
    {
      "name": "astral key sorts after a high BMP key",
      "input": {
        "json": "{\"\\ud834\\udd1e\":1,\"\\uffff\":2,\"a\":3}"
      },
      "expected": {
        "text": "{\"a\": 3, \"\\uffff\": 2, \"\\ud834\\udd1e\": 1}",
        "sha256": "244d2b0b97fa0378132965789c7528a123cf3cc74bfd0b7efc513b9595719abf"
      },
      "differs": {
        "js": {
          "text": "{\"a\": 3, \"\\ud834\\udd1e\": 1, \"\\uffff\": 2}",
          "sha256": "83637ae9a9309bf6bdbe719805def3546f49fbcb2861da700a0b6418e9fb5803"
        }
      },
      "rule": "03 \u2014 keys sort by Unicode code point (JS sorts by UTF-16 unit)"
    },
    {
      "name": "duplicate keys keep the last value",
      "input": {
        "json": "{\"a\":1,\"b\":2,\"a\":3}"
      },
      "expected": {
        "text": "{\"a\": 3, \"b\": 2}",
        "sha256": "34600dd287a7fe5153d2ee3752ccdc970a90166cb940849bc3bfa7c1733d07a6"
      }
    },
    {
      "name": "ascii passes through",
      "input": {
        "json": "\"plain text 123\""
      },
      "expected": {
        "text": "\"plain text 123\"",
        "sha256": "b5bda98c05e2bd144ae16dadae31d94198269775bceda6b1974b2ce23593d801"
      }
    },
    {
      "name": "quote and backslash",
      "input": {
        "json": "\"say \\\"hi\\\" \\\\ done\""
      },
      "expected": {
        "text": "\"say \\\"hi\\\" \\\\ done\"",
        "sha256": "7e2a1e0c60a7bb87f6f2d08bf37c9a364fdf1dc6cc659ddaff5b7ffac0b91810"
      }
    },
    {
      "name": "forward slash is not escaped",
      "input": {
        "json": "\"a/b\""
      },
      "expected": {
        "text": "\"a/b\"",
        "sha256": "f5effa31772a3689cb116700c569f4b72d765290968f099016a899ab6c1e4ee3"
      }
    },
    {
      "name": "named control escapes",
      "input": {
        "json": "\"\\n\\r\\t\\b\\f\""
      },
      "expected": {
        "text": "\"\\n\\r\\t\\b\\f\"",
        "sha256": "9238ce80d35d301c4411072a8f184960a77840aee9f8c6bbc89116dd5471bf24"
      }
    },
    {
      "name": "other control characters use \\u00xx",
      "input": {
        "json": "\"\\u0000\\u0001\\u001f\""
      },
      "expected": {
        "text": "\"\\u0000\\u0001\\u001f\"",
        "sha256": "842096a6d3fcd0968fe35809ea5810d33f7072b93743fc0f7b4ff484ae727d20"
      }
    },
    {
      "name": "U+007F is escaped",
      "input": {
        "json": "\"\\u007f\""
      },
      "expected": {
        "text": "\"\\u007f\"",
        "sha256": "226453a6508483054f1ddc449c26b45077f5a45d993034f0f5f04f3f9801c32c"
      }
    },
    {
      "name": "latin-1 is escaped lower-case",
      "input": {
        "json": "\"\u00e9 \u00ff\""
      },
      "expected": {
        "text": "\"\\u00e9 \\u00ff\"",
        "sha256": "a65a9c4290a860ce4d5742699be364276d0dab75e0c3ea635b8aba6b64b0358a"
      }
    },
    {
      "name": "BMP character",
      "input": {
        "json": "\"\u65e5\u672c\u8a9e\""
      },
      "expected": {
        "text": "\"\\u65e5\\u672c\\u8a9e\"",
        "sha256": "074aeb45b116186c75c381f35ffecf3ac8b5a1d182682d12f756954a5c4d7a6a"
      }
    },
    {
      "name": "U+2028 and U+2029",
      "input": {
        "json": "\"\\u2028\\u2029\""
      },
      "expected": {
        "text": "\"\\u2028\\u2029\"",
        "sha256": "b36c0076c7e28a52a8a9cb89306b164f887df89d715680d7b1ca8a858a8f3d33"
      }
    },
    {
      "name": "astral character becomes a surrogate pair",
      "input": {
        "json": "\"\ud834\udd1e \ud83d\ude00\""
      },
      "expected": {
        "text": "\"\\ud834\\udd1e \\ud83d\\ude00\"",
        "sha256": "e91b62b7fc492ba8d080df3b8d3339d2dff5c3a860ab6531ad408afa1b5da3b3"
      }
    },
    {
      "name": "U+FFFF",
      "input": {
        "json": "\"\\uffff\""
      },
      "expected": {
        "text": "\"\\uffff\"",
        "sha256": "1ef1b6da15ca38e4564f03db3fa65252bcdd156176731c3b671fb2a6734fd8f2"
      }
    },
    {
      "name": "integer",
      "input": {
        "json": "12"
      },
      "expected": {
        "text": "12",
        "sha256": "6b51d431df5d7f141cbececcf79edf3dd861c3b4069f0b11661a3eefacbba918"
      }
    },
    {
      "name": "negative integer",
      "input": {
        "json": "-7"
      },
      "expected": {
        "text": "-7",
        "sha256": "a770d3270c9dcdedf12ed9fd70444f7c8a95c26cae3cae9bd867499090a2f14b"
      }
    },
    {
      "name": "zero",
      "input": {
        "json": "0"
      },
      "expected": {
        "text": "0",
        "sha256": "5feceb66ffc86f38d952786c6d696c79c2dbc239dd4e91b46729d73a27fb57e9"
      }
    },
    {
      "name": "float keeps its .0",
      "input": {
        "json": "12.0"
      },
      "expected": {
        "text": "12.0",
        "sha256": "77c52f3feed5acdd119b1f8449d5ccc2d39be94bd0314d5b7302f36e20b6cea9"
      },
      "differs": {
        "js": {
          "text": "12",
          "sha256": "6b51d431df5d7f141cbececcf79edf3dd861c3b4069f0b11661a3eefacbba918"
        }
      },
      "rule": "D4 \u2014 a float keeps its .0 and follows Python's repr; JS cannot tell 12.0 from 12"
    },
    {
      "name": "negative zero float",
      "input": {
        "json": "-0.0"
      },
      "expected": {
        "text": "-0.0",
        "sha256": "c26617c7ccbcaa6631b45d851b8cf56e21d2ca624bdb1193afdbd4b560702cec"
      },
      "differs": {
        "js": {
          "text": "0",
          "sha256": "5feceb66ffc86f38d952786c6d696c79c2dbc239dd4e91b46729d73a27fb57e9"
        }
      },
      "rule": "D4 \u2014 a float keeps its .0 and follows Python's repr; JS cannot tell 12.0 from 12"
    },
    {
      "name": "zero float",
      "input": {
        "json": "0.0"
      },
      "expected": {
        "text": "0.0",
        "sha256": "8aed642bf5118b9d3c859bd4be35ecac75b6e873cce34e7b6f554b06f75550d7"
      },
      "differs": {
        "js": {
          "text": "0",
          "sha256": "5feceb66ffc86f38d952786c6d696c79c2dbc239dd4e91b46729d73a27fb57e9"
        }
      },
      "rule": "D4 \u2014 a float keeps its .0 and follows Python's repr; JS cannot tell 12.0 from 12"
    },
    {
      "name": "integer above 2^53",
      "input": {
        "json": "9007199254740993"
      },
      "expected": {
        "text": "9007199254740993",
        "sha256": "a1c367c29158357e62a3ff5d3e800fb7698a22396439dbc0a9d4929322afd35d"
      },
      "differs": {
        "js": {
          "text": "9007199254740992",
          "sha256": "c681da39d7273a6a24c15c9cac3a75526ff2ecf8ba4ee60346a0c70c8163bdb2"
        }
      },
      "rule": "D4 \u2014 integers keep every digit (JS numbers lose precision above 2^53)"
    },
    {
      "name": "integer above u64",
      "input": {
        "json": "18446744073709551617"
      },
      "expected": {
        "text": "18446744073709551617",
        "sha256": "a8482330e723ad4642b78444cbdb507ff747c51bbc0fa57e4546641336393be7"
      },
      "differs": {
        "js": {
          "text": "18446744073709552000",
          "sha256": "edacbbb2252b28815fa8983aad4682ab7718badd58a7e92c6b65b4292f308225"
        }
      },
      "rule": "D4 \u2014 integers keep every digit (JS numbers lose precision above 2^53)"
    },
    {
      "name": "integer far above u64",
      "input": {
        "json": "-12345678901234567890123456789"
      },
      "expected": {
        "text": "-12345678901234567890123456789",
        "sha256": "e13249437d3c31bdc824a5cd6d4ceaf9b380bb28c9f41dd492ef9c01f64a2243"
      },
      "differs": {
        "js": {
          "text": "-1.2345678901234568e+28",
          "sha256": "e7d5b0a0359bf0740aaab785e70e3ebae705df5f435f5ccaae6cf75d27a6d55b"
        }
      },
      "rule": "D4 \u2014 integers keep every digit (JS numbers lose precision above 2^53)"
    },
    {
      "name": "float below 1e-4 uses an exponent",
      "input": {
        "json": "0.00001"
