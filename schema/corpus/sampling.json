          {
            "kept": true,
            "written": [
              "i1",
              "d1"
            ]
          },
          {
            "kept": true,
            "written": []
          },
          {
            "kept": false,
            "written": []
          }
        ],
        "state": {
          "buffered_traces": [
            "t2"
          ],
          "buffered_records": 1,
          "elevated": [
            "t1"
          ]
        }
      }
    },
