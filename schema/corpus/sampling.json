{
  "group": "sampling",
  "description": "Probabilistic sampling, with tail-based elevation of a whole trace and bounded buffers.",
  "references": {
    "python": "2.0.0",
    "js": "4354829"
  },
  "cases": [
    {
      "name": "plain rate: a draw below the rate keeps, equal or above drops",
      "input": {
        "steps": [
          {
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "INFO",
              "logger": "app",
              "message": "a",
              "meta": {}
            },
            "rng": 0.1
          },
          {
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "INFO",
              "logger": "app",
              "message": "b",
              "meta": {}
            },
            "rng": 0.5
          },
          {
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "INFO",
              "logger": "app",
              "message": "c",
              "meta": {}
            },
            "rng": 0.49
          },
          {
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "INFO",
              "logger": "app",
              "message": "d",
              "meta": {}
            },
            "rng": 0.9
          }
        ],
        "options": {
          "rate": 0.5
        }
      },
      "expected": {
        "steps": [
          {
            "kept": true,
            "written": []
          },
          {
            "kept": false,
            "written": []
          },
          {
            "kept": true,
            "written": []
          },
          {
            "kept": false,
            "written": []
          }
        ],
        "state": {
          "buffered_traces": [],
          "buffered_records": 0,
          "elevated": []
        }
      }
    },
