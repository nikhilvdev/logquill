      "expected": {
        "steps": [
          {
            "kept": true,
            "written": []
          },
          {
            "kept": true,
            "written": []
          }
        ],
        "state": {
          "buffered_runs": [],
          "buffered_records": 0,
          "flushed": []
        }
      }
    },
    {
      "name": "an error flushes the run's buffered context",
      "input": {
        "steps": [
          {
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "DEBUG",
              "logger": "app",
              "message": "d1",
              "meta": {
                "run_id": "r1"
