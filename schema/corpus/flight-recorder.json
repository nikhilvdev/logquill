{
  "group": "flight-recorder",
  "description": "A per-run ring buffer of low-level records that ships only when the run errors.",
  "references": {
    "python": "2.0.0",
    "js": "4354829"
  },
  "js_gaps": [
    "no flight recorder in the JavaScript package"
  ],
  "cases": [
    {
      "name": "records at or above ship_at pass straight through",
      "input": {
        "steps": [
          {
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "INFO",
              "logger": "app",
              "message": "i",
              "meta": {
                "run_id": "r1"
              }
            }
          },
          {
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "WARN",
              "logger": "app",
              "message": "w",
              "meta": {
                "run_id": "r1"
              }
            }
          }
        ],
        "options": {}
      },
      "expected": {
        "steps": [
          {
            "kept": true,
            "written": []
          },
          {
            "kept": true,
            "written": []
          }
        ],
        "state": {
          "buffered_runs": [],
          "buffered_records": 0,
          "flushed": []
        }
      }
    },
    {
      "name": "a record with no run id passes through",
      "input": {
        "steps": [
          {
            "record": {
              "schema_version": "2.0",
