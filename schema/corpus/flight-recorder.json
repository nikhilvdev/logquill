            }
          },
          {
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "TRACE",
              "logger": "app",
              "message": "t1",
              "meta": {
                "run_id": "r1"
              }
            }
          },
          {
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "ERROR",
              "logger": "app",
              "message": "boom",
              "meta": {
                "run_id": "r1"
              }
            }
          },
          {
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "DEBUG",
              "logger": "app",
              "message": "d2",
              "meta": {
                "run_id": "r1"
              }
            }
          }
        ],
        "options": {}
      },
      "expected": {
        "steps": [
          {
            "kept": false,
            "written": []
          },
          {
            "kept": false,
            "written": []
          },
          {
            "kept": true,
            "written": [
              "d1",
              "t1"
            ]
          },
          {
            "kept": true,
            "written": []
          }
        ],
        "state": {
          "buffered_runs": [],
          "buffered_records": 0,
          "flushed": [
            "r1"
          ]
        }
      }
    },
