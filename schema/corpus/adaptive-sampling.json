{
  "group": "adaptive-sampling",
  "description": "Sampling that keeps errors and slow spans, adjusts its rate to demand, and caps bytes per second.",
  "references": {
    "python": "2.0.0",
    "js": "4354829"
  },
  "js_gaps": [
    "no adaptive sampling in the JavaScript package"
  ],
  "cases": [
    {
      "name": "below the rate keeps, at or above drops",
      "input": {
        "steps": [
          {
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "INFO",
              "logger": "app",
              "message": "a",
              "meta": {}
            },
            "rng": 0.49,
            "clock": 0.1
          },
          {
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "INFO",
              "logger": "app",
              "message": "b",
              "meta": {}
            },
            "rng": 0.5,
            "clock": 0.2
          }
        ],
        "options": {
          "base_rate": 0.5,
          "min_rate": 0.1,
          "max_rate": 0.9,
          "window_seconds": 1.0,
          "max_bytes_per_second": 100000
        }
      },
      "expected": {
        "steps": [
          {
            "kept": true,
            "written": []
          },
          {
            "kept": false,
            "written": []
          }
        ],
        "state": {
          "rate": 0.5,
          "window_demand_bytes": 117,
          "window_emitted_bytes": 117
        }
      }
    },
