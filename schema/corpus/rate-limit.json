{
  "group": "rate-limit",
  "description": "Dropping records past a per-key quota inside a rolling window.",
  "references": {
    "python": "2.0.0",
    "js": "4354829"
  },
  "cases": [
    {
      "name": "a window allows its quota then drops",
      "input": {
        "steps": [
          {
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "INFO",
              "logger": "app",
              "message": "m",
              "meta": {}
            },
            "clock": 0
          },
          {
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "INFO",
              "logger": "app",
              "message": "m",
              "meta": {}
            },
            "clock": 1
          },
          {
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "INFO",
              "logger": "app",
              "message": "m",
              "meta": {}
            },
            "clock": 2
          },
          {
            "record": {
              "schema_version": "2.0",
              "timestamp": "2026-01-01T00:00:00.000Z",
              "level": "INFO",
              "logger": "app",
              "message": "m",
              "meta": {}
            },
            "clock": 3
          }
        ],
        "options": {
          "max_records": 2,
          "per_seconds": 10
        }
      },
      "expected": {
        "steps": [
          {
            "kept": true,
            "written": []
          },
          {
            "kept": true,
            "written": []
          },
          {
            "kept": false,
            "written": []
          },
          {
            "kept": false,
            "written": []
          }
        ],
        "state": {
          "windows": [
            [
              [
                "app",
                "INFO"
              ],
              0,
              2
            ]
          ]
        }
      }
    },
