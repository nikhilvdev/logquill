root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,ts,js,mjs,kts,swift,rb,gemspec,csproj}]
indent_size = 2

[{Makefile,*.go}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
