# ── Secrets & local env — never commit ──────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
**/secrets/

# ── Rust and other build output ──────────────────────────────────────
target/
**/*.rs.bk
*.profraw
node_modules/

# ── Python (the Python binding's tooling) ────────────────────────────
.venv/
**/__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/

# ── Editors / OS cruft ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# ── Logs produced during local runs/tests ────────────────────────────
*.log
*.log.[0-9]
CLAUDE.md
.vscode/
graphify-out/
.claude/
.codex/
Agents.md

# The compiled extension that `maturin develop` places beside the Python sources.
bindings/python/python/logquill/*.so
bindings/python/python/logquill/*.pyd
bindings/python/python/logquill/*.dylib

# ── Node binding build output ────────────────────────────────────────
*.node

# WebAssembly build output (bindings/node): built by `npm run build:wasm`
bindings/node/wasm-out/
bindings/node/*.wasm
bindings/node/logquill.wasi*.cjs
bindings/node/logquill.wasi-browser.js
bindings/node/wasi-worker*.mjs
bindings/node/dist/
